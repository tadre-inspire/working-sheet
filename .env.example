# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public values (safe in the browser). Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the app is served. Used for Paystack's return link.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Server-only secrets. Keep these out of git and out of the browser.
# Supabase dashboard > Project Settings > API keys > secret key
SUPABASE_SERVICE_ROLE_KEY=
# Paystack dashboard > Settings > API Keys. Use the TEST secret key first.
PAYSTACK_SECRET_KEY=
